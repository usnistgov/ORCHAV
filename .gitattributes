* text=auto eol=lf
# Keep executable shell scripts portable when contributors use core.autocrlf.
*.sh text eol=lf

# Protobuf regeneration is byte-checked across supported platforms.
shared/protos/*_pb2.py text eol=lf
shared/protos/*_pb2_grpc.py text eol=lf

# Sensing documentation authenticates these source inputs byte-for-byte.
scenarios/sensing/*/scenario.yaml text eol=lf
generator/core/services/raytracing_service.py text eol=lf
shared/sensing/postprocessor.py text eol=lf
visualizer/src/sensing/replay_cli.py text eol=lf
libraries/scenes/empty/empty.xml text eol=lf
libraries/targets/cube/cube.ply text eol=lf
libraries/targets/uav/*/drone.obj text eol=lf
libraries/targets/uav/*/geometry.json text eol=lf

# Preserve authenticated third-party license evidence byte-for-byte.
scenarios/showcases/paris_opera_multitarget/inputs/vehicles/bmw/source_license.js -text

# Generated local outputs are not part of source archives.
*.jsonl export-ignore
scenarios/*/frames/ export-ignore
scenarios/*/summary/ export-ignore
scenarios/*/experiments/ export-ignore

# Matplotlib SVG path spacing is retained for scientific receipt hashes.
scenarios/sensing/foundations/RCS/*/results/*.svg whitespace=-blank-at-eol
